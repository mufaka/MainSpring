@model ApplicationConfiguration
@{
    ViewData["Title"] = $"Edit {Model.ConfigurationName}";
}

<form asp-action="Edit" asp-route-id="@Model.ApplicationConfigurationId" method="post" class="space-y-8">
    <input type="hidden" asp-for="ApplicationConfigurationId" />
    <input type="hidden" asp-for="InsertDate" />

    <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Application configuration</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">Edit @Model.ConfigurationName</h1>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Update the stored value and grouping metadata for this configuration entry.</p>
    </div>

    <partial name="_ConfigurationForm" model="Model" />

    <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-sky-500">Save changes</button>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
