@model ApplicationConfiguration

<section class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
    <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200"></div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
        <div>
            <label asp-for="CategoryName" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="CategoryName" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
            <span asp-validation-for="CategoryName" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
        <div>
            <label asp-for="ConfigurationName" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="ConfigurationName" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
            <span asp-validation-for="ConfigurationName" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
        <div class="md:col-span-2">
            <label asp-for="ConfigurationValue" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <textarea asp-for="ConfigurationValue" rows="5" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20"></textarea>
            <span asp-validation-for="ConfigurationValue" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
    </div>
</section>
