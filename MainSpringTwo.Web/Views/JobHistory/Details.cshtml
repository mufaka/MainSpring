@model JobHistory
@{
    ViewData["Title"] = $"History #{Model.JobHistoryId}";
}

<div class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] @(Model.IsError ? "text-rose-600 dark:text-rose-300" : "text-sky-600 dark:text-sky-300")">Operational logs</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">@(Model.ScheduledJob?.Name ?? "Scheduled job")</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Inspect the full message payload and execution detail captured for this run.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Back to history</a>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr),minmax(0,1.35fr)]">
        <section class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <dl class="grid gap-6">
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Run time</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@Model.RunTime.ToLocalTime().ToString("f")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Status</dt>
                    <dd class="mt-2"><span class="inline-flex rounded-full px-3 py-1 text-xs font-medium @(Model.IsError ? "bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300")">@(Model.IsError ? "Error" : "Success")</span></dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Message</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@Model.Message</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Detail payload</h2>
            <pre class="mt-4 overflow-x-auto rounded-3xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-700 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.Detail) ? "No additional detail was captured for this run." : Model.Detail)</pre>
        </section>
    </div>
</div>
