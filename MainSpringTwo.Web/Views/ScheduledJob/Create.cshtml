@model ScheduledJobViewModel
@{
    ViewData["Title"] = "Create scheduled job";
}

<form id="scheduled-job-form" asp-action="Create" method="post" class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Scheduled jobs</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">Create a new automated job</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Define the schedule and inline plugin configuration that Hangfire will execute.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Back to jobs</a>
    </div>

    @Html.HiddenFor(model => model.ScheduledJob.ScheduledJobId)
    <partial name="_Form" model="Model" />

    <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-sky-500">Create job</button>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Cancel</a>
    </div>
</form>

