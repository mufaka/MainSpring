@model ScheduledJob
@{
    ViewData["Title"] = Model.Name;
    string ScheduleSummary()
    {
        var unit = Model.ScheduleType.ToString().ToLowerInvariant();
        return $"Every {Model.Interval} {unit}{(Model.Interval == 1 ? string.Empty : "s")}";
    }
}

<div class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Scheduled job</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">@Model.Name</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Review the plugin binding, schedule cadence, and persisted configuration values for this job.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <form asp-action="RunNow" asp-route-id="@Model.ScheduledJobId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-4 py-3 text-sm font-medium text-white transition hover:bg-sky-500">Run now</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Edit job</a>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr),minmax(280px,1fr)]">
        <section class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <dl class="grid gap-6 sm:grid-cols-2">
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Plugin</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@(Model.Plugin?.Name ?? "Unassigned")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Status</dt>
                    <dd class="mt-2"><span class="inline-flex rounded-full px-3 py-1 text-xs font-medium @(Model.IsActive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300" : "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Schedule</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@ScheduleSummary()</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Start time</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@Model.StartTime.ToLocalTime().ToString("f")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Next run</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@(ScheduleHelper.GetNextRunTime(Model, DateTime.UtcNow)?.ToLocalTime().ToString("f") ?? "Not scheduled")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Updated</dt>
                    <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@Model.UpdateDate.ToLocalTime().ToString("g")</dd>
                </div>
            </dl>
        </section>

        <section class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Configuration snapshot</h2>
            @if (Model.ConfigurationValues.Count == 0)
            {
                <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">No configuration values are stored for this job.</p>
            }
            else
            {
                <div class="mt-4 space-y-3">
                    @foreach (var value in Model.ConfigurationValues.OrderBy(entry => entry.ParameterName))
                    {
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-white/10 dark:bg-slate-900/70">
                            <p class="text-sm font-medium text-slate-950 dark:text-white">@value.ParameterName</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@(string.IsNullOrWhiteSpace(value.Value) ? "(empty)" : value.Value)</p>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
