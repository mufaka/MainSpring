@model ScheduledJobViewModel

<section id="plugin-configuration-section" class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Plugin configuration</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Parameter metadata comes directly from the selected compiled plugin.</p>
        </div>
        <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 dark:border-white/10 dark:bg-slate-900 dark:text-slate-300">@Model.PluginParameters.Count parameter(s)</span>
    </div>

    @if (Model.PluginParameters.Count == 0)
    {
        <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-sm text-slate-600 dark:border-white/10 dark:bg-slate-900/40 dark:text-slate-300">
            This plugin does not require additional configuration values.
        </div>
    }
    else
    {
        <div class="mt-6 grid gap-5 lg:grid-cols-2">
            @for (var i = 0; i < Model.PluginParameters.Count; i++)
            {
                var parameter = Model.PluginParameters[i];
                var value = Model.ConfigurationValues.ElementAtOrDefault(i) ?? new ConfigurationValue { ParameterName = parameter.Name };
                var normalizedValue = value.Value ?? string.Empty;
                var boolValue = string.Equals(normalizedValue, "true", StringComparison.OrdinalIgnoreCase);
                var dateValue = DateTime.TryParse(normalizedValue, out var parsedDate)
                    ? (parsedDate.Kind == DateTimeKind.Utc ? parsedDate.ToLocalTime() : parsedDate).ToString("yyyy-MM-ddTHH:mm")
                    : string.Empty;
                var fieldKey = $"ConfigurationValues[{i}].Value";
                var fieldErrors = ViewData.ModelState.TryGetValue(fieldKey, out var fieldState)
                    ? fieldState.Errors
                        .Select(error => error.ErrorMessage)
                        .Where(message => !string.IsNullOrWhiteSpace(message))
                        .ToList()
                    : [];

                <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-5 dark:border-white/10 dark:bg-slate-900/60">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-950 dark:text-white">@parameter.Name</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@parameter.Description</p>
                            @if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.List && parameter.Options.Count > 0)
                            {
                                <p class="mt-2 text-xs font-medium uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Options: @string.Join(", ", parameter.Options.Select(option => string.IsNullOrWhiteSpace(option.Label) ? option.Value : option.Label))</p>
                            }
                        </div>
                        <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 dark:border-white/10 dark:bg-slate-950 dark:text-slate-300">@parameter.DataType</span>
                    </div>

                    <input type="hidden" name="ConfigurationValues[@i].ConfigurationValueId" value="@value.ConfigurationValueId" />
                    <input type="hidden" name="ConfigurationValues[@i].ScheduledJobId" value="@value.ScheduledJobId" />
                    <input type="hidden" name="ConfigurationValues[@i].ParameterName" value="@parameter.Name" />

                    <div class="mt-4">
                        @if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.Text)
                        {
                            <textarea name="ConfigurationValues[@i].Value" rows="4" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20">@normalizedValue</textarea>
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.Boolean)
                        {
                            <div x-data="{ enabled: @(boolValue ? "true" : "false") }" class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-white/10 dark:bg-slate-950/80">
                                <input type="hidden" name="ConfigurationValues[@i].Value" :value="enabled ? 'true' : 'false'" />
                                <button type="button" class="flex w-full items-center justify-between gap-3 text-left" @@click="enabled = !enabled">
                                    <span>
                                        <span class="block text-sm font-medium text-slate-900 dark:text-white">Toggle value</span>
                                        <span class="mt-1 block text-sm text-slate-500 dark:text-slate-400">Use this for on/off plugin settings.</span>
                                    </span>
                                    <span class="relative inline-flex h-7 w-12 items-center rounded-full transition" :class="enabled ? 'bg-sky-500' : 'bg-slate-300 dark:bg-slate-700'">
                                        <span class="inline-block h-5 w-5 transform rounded-full bg-white transition" :class="enabled ? 'translate-x-6' : 'translate-x-1'"></span>
                                    </span>
                                </button>
                            </div>
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.Integer)
                        {
                            <input name="ConfigurationValues[@i].Value" type="number" step="1" value="@normalizedValue" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.Decimal)
                        {
                            <input name="ConfigurationValues[@i].Value" type="number" step="0.01" value="@normalizedValue" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.DateTime)
                        {
                            <input name="ConfigurationValues[@i].Value" type="datetime-local" value="@dateValue" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.Password)
                        {
                            <input name="ConfigurationValues[@i].Value" type="password" value="@normalizedValue" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
                        }
                        else if (parameter.DataType == MainSpringTwo.Web.Models.Plugins.ParameterDataType.List)
                        {
                            <select name="ConfigurationValues[@i].Value" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20">
                                <option value="">Select an option</option>
                                @foreach (var option in parameter.Options)
                                {
                                    if (string.Equals(normalizedValue, option.Value, StringComparison.Ordinal))
                                    {
                                        <option value="@option.Value" selected>@(string.IsNullOrWhiteSpace(option.Label) ? option.Value : option.Label)</option>
                                    }
                                    else
                                    {
                                        <option value="@option.Value">@(string.IsNullOrWhiteSpace(option.Label) ? option.Value : option.Label)</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <input name="ConfigurationValues[@i].Value" type="text" value="@normalizedValue" class="block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-950/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" />
                        }

                        @if (fieldErrors.Count > 0)
                        {
                            <div class="mt-2 space-y-1">
                                @foreach (var error in fieldErrors)
                                {
                                    <p class="text-sm text-rose-600 dark:text-rose-300">@error</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>
