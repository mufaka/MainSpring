@model List<ScheduledJob>
@{
    ViewData["Title"] = "Scheduled Jobs";

    string ScheduleSummary(ScheduledJob job)
    {
        var unit = job.ScheduleType.ToString().ToLowerInvariant();
        return $"Every {job.Interval} {unit}{(job.Interval == 1 ? string.Empty : "s")}";
    }
}

<div class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Scheduled jobs</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">Automation orchestration</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Manage plugin schedules, review configuration bindings, and launch immediate executions.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-sky-500">Create scheduled job</a>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/85 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
        <div class="flex items-center justify-between gap-4 border-b border-slate-200/70 px-6 py-5 dark:border-white/10">
            <div>
                <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Current jobs</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Each job executes a compiled plugin using the stored schedule and configuration values.</p>
            </div>
            <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 dark:border-white/10 dark:bg-slate-900 dark:text-slate-300">@Model.Count total</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="px-6 py-10 text-center text-sm text-slate-600 dark:text-slate-300">No scheduled jobs exist yet. Create one to start the automation pipeline.</div>
        }
        else
        {
            <div class="space-y-4 px-4 py-4 lg:hidden">
                @foreach (var job in Model)
                {
                    <article class="rounded-3xl border border-slate-200 bg-slate-50/80 p-5 dark:border-white/10 dark:bg-slate-900/70">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="text-base font-semibold text-slate-950 dark:text-white">@job.Name</h3>
                                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@(job.Plugin?.Name ?? "Unassigned plugin")</p>
                            </div>
                            <span class="inline-flex rounded-full px-3 py-1 text-xs font-medium @(job.IsActive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300" : "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">@(job.IsActive ? "Active" : "Inactive")</span>
                        </div>

                        <dl class="mt-4 grid gap-3 text-sm text-slate-600 dark:text-slate-300 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Schedule</dt>
                                <dd class="mt-1">@ScheduleSummary(job)</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Next run</dt>
                                <dd class="mt-1">@(job.NextRunTime?.ToLocalTime().ToString("g") ?? "Not scheduled")</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Starts</dt>
                                <dd class="mt-1">@job.StartTime.ToLocalTime().ToString("g")</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Configuration</dt>
                                <dd class="mt-1">@job.ConfigurationValues.Count value(s)</dd>
                            </div>
                        </dl>

                        <div class="mt-5 flex flex-wrap gap-2">
                            <form asp-action="RunNow" asp-route-id="@job.ScheduledJobId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-medium text-sky-700 transition hover:bg-sky-100 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-200 dark:hover:bg-sky-500/20">Run now</button>
                            </form>
                            <a asp-action="Details" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-950/70 dark:text-slate-200 dark:hover:bg-slate-800">Details</a>
                            <a asp-action="Edit" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-950/70 dark:text-slate-200 dark:hover:bg-slate-800">Edit</a>
                            <a asp-action="Delete" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-100 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/20">Delete</a>
                        </div>
                    </article>
                }
            </div>

            <div class="hidden overflow-x-auto lg:block">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
                    <thead class="bg-slate-50/80 dark:bg-slate-900/80">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Job</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Plugin</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Schedule</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Next run</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Status</th>
                            <th class="px-6 py-4"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-white/10">
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="px-6 py-4 align-top">
                                    <p class="text-sm font-medium text-slate-950 dark:text-white">@job.Name</p>
                                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@job.ConfigurationValues.Count configuration value(s)</p>
                                </td>
                                <td class="px-6 py-4 align-top text-sm text-slate-600 dark:text-slate-300">@(job.Plugin?.Name ?? "Unassigned")</td>
                                <td class="px-6 py-4 align-top text-sm text-slate-600 dark:text-slate-300">
                                    <p>@ScheduleSummary(job)</p>
                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Starts @job.StartTime.ToLocalTime().ToString("g")</p>
                                </td>
                                <td class="px-6 py-4 align-top text-sm text-slate-600 dark:text-slate-300">@(job.NextRunTime?.ToLocalTime().ToString("g") ?? "Not scheduled")</td>
                                <td class="px-6 py-4 align-top text-sm"><span class="inline-flex rounded-full px-3 py-1 text-xs font-medium @(job.IsActive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300" : "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300")">@(job.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="px-6 py-4 align-top">
                                    <div class="flex flex-wrap justify-end gap-2">
                                        <form asp-action="RunNow" asp-route-id="@job.ScheduledJobId" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center rounded-2xl border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-medium text-sky-700 transition hover:bg-sky-100 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-200 dark:hover:bg-sky-500/20">Run now</button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Details</a>
                                        <a asp-action="Edit" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@job.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-100 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/20">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
