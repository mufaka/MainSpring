@model ScheduledJob
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<div x-data="{ confirmOpen: false }" class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-rose-600 dark:text-rose-300">Danger zone</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">Delete @Model.Name</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">This removes the schedule and its inline configuration values. Existing job history remains available unless separately pruned.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Back to jobs</a>
    </div>

    <section class="rounded-[2rem] border border-rose-200 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-rose-500/20 dark:bg-slate-950/70">
        <dl class="grid gap-6 md:grid-cols-3">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Plugin</dt>
                <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@(Model.Plugin?.Name ?? "Unassigned")</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Status</dt>
                <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@(Model.IsActive ? "Active" : "Inactive")</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Configuration values</dt>
                <dd class="mt-2 text-base font-medium text-slate-950 dark:text-white">@Model.ConfigurationValues.Count</dd>
            </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
            <button type="button" class="inline-flex items-center justify-center rounded-2xl bg-rose-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-rose-500" @@click="confirmOpen = true">Delete job</button>
            <a asp-action="Details" asp-route-id="@Model.ScheduledJobId" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Cancel</a>
        </div>
    </section>

    <div x-cloak x-show="confirmOpen" class="fixed inset-0 z-[90] flex items-center justify-center bg-slate-950/60 px-4 backdrop-blur-sm" x-transition.opacity>
        <div class="w-full max-w-lg rounded-[2rem] border border-white/60 bg-white p-6 shadow-2xl dark:border-white/10 dark:bg-slate-950">
            <h2 class="text-xl font-semibold text-slate-950 dark:text-white">Delete this scheduled job?</h2>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">This action cannot be undone. The schedule, configuration values, and future execution plan will be removed.</p>
            <div class="mt-6 flex flex-wrap gap-3">
                <form asp-action="Delete" asp-route-id="@Model.ScheduledJobId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-rose-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-rose-500">Confirm delete</button>
                </form>
                <button type="button" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800" @@click="confirmOpen = false">Keep job</button>
            </div>
        </div>
    </div>
</div>
