@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var pageSection = ViewData["Section"]?.ToString() ?? "Operations";

    string NavLinkClasses(string controller) => currentController == controller
        ? "bg-sky-600/10 text-sky-700 ring-1 ring-inset ring-sky-200 dark:bg-sky-500/10 dark:text-sky-200 dark:ring-sky-500/30"
        : "text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-slate-800/80 dark:hover:text-white";
}
<!DOCTYPE html>
<html lang="en" class="h-full" x-data="{ darkMode: localStorage.getItem('dark') === 'true', sidebarOpen: false }"
      x-init="$watch('darkMode', value => { localStorage.setItem('dark', value); document.documentElement.classList.toggle('dark', value); }); document.documentElement.classList.toggle('dark', darkMode)"
      :class="{ 'dark': darkMode }">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MainSpring</title>
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-950 text-slate-900 antialiased dark:text-slate-100">
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.20),_transparent_35%),radial-gradient(circle_at_bottom_right,_rgba(99,102,241,0.18),_transparent_30%),linear-gradient(180deg,_#f8fafc_0%,_#eef2ff_45%,_#f8fafc_100%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.12),_transparent_30%),radial-gradient(circle_at_bottom_right,_rgba(59,130,246,0.12),_transparent_28%),linear-gradient(180deg,_#020617_0%,_#0f172a_40%,_#020617_100%)]"></div>

    <div class="min-h-full lg:flex">
        <div class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-sm lg:hidden" x-cloak x-show="sidebarOpen" x-transition.opacity @@click="sidebarOpen = false"></div>

        <aside class="fixed inset-y-0 left-0 z-50 flex w-80 -translate-x-full flex-col border-r border-white/60 bg-white/90 px-5 py-6 shadow-2xl shadow-slate-950/10 backdrop-blur-xl transition-transform duration-200 dark:border-white/10 dark:bg-slate-950/80 dark:shadow-black/40 lg:static lg:translate-x-0 lg:shadow-none"
               :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'">
            <div class="flex items-center justify-between gap-3 px-2">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                    <span class="flex h-12 w-12 items-center justify-center rounded-3xl bg-gradient-to-br from-sky-500 via-cyan-500 to-indigo-500 text-sm font-semibold tracking-[0.25em] text-white shadow-lg shadow-sky-500/30">MS</span>
                    <span>
                        <span class="block text-xs font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">MainSpring</span>
                        <span class="block text-lg font-semibold text-slate-950 dark:text-white">Control Center</span>
                    </span>
                </a>
                <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white lg:hidden" @@click="sidebarOpen = false">
                    <span class="sr-only">Close navigation</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mt-8 rounded-3xl border border-sky-200/70 bg-gradient-to-br from-sky-50 via-white to-cyan-50 p-5 shadow-sm dark:border-sky-500/20 dark:from-sky-500/10 dark:via-slate-900 dark:to-slate-900">
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-700 dark:text-sky-300">Live environment</p>
                    <h2 class="mt-2 text-xl font-semibold text-slate-950 dark:text-white">@pageSection</h2>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                    Operate jobs, plugins, and history from a single responsive workspace.
                </p>
                <div class="mt-4 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                    <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                    <span>Scheduler and dashboard are online</span>
                </div>
            </div>

            <nav class="mt-8 flex-1 space-y-2">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition @NavLinkClasses("Home")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.125 1.125 0 0 1 1.591 0L21.75 12M4.5 9.75V19.5A1.5 1.5 0 0 0 6 21h3.75v-5.25c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21H18a1.5 1.5 0 0 0 1.5-1.5V9.75" /></svg>
                    <span>Dashboard</span>
                </a>
                <a asp-controller="ScheduledJob" asp-action="Index" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition @NavLinkClasses("ScheduledJob")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    <span>Scheduled Jobs</span>
                </a>
                <a asp-controller="Plugin" asp-action="Index" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition @NavLinkClasses("Plugin")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.778.63-1.409 1.409-1.409h1.765c.778 0 1.409.63 1.409 1.409v1.765c0 .778-.63 1.409-1.409 1.409h-1.765a1.409 1.409 0 0 1-1.409-1.409V6.087Zm-9 9c0-.778.63-1.409 1.409-1.409h1.765c.778 0 1.409.63 1.409 1.409v1.765c0 .778-.63 1.409-1.409 1.409H6.659a1.409 1.409 0 0 1-1.409-1.409v-1.765Zm9 0c0-.778.63-1.409 1.409-1.409h1.765c.778 0 1.409.63 1.409 1.409v1.765c0 .778-.63 1.409-1.409 1.409h-1.765a1.409 1.409 0 0 1-1.409-1.409v-1.765Zm-9-9c0-.778.63-1.409 1.409-1.409h1.765c.778 0 1.409.63 1.409 1.409v1.765c0 .778-.63 1.409-1.409 1.409H6.659A1.409 1.409 0 0 1 5.25 7.852V6.087Z" /></svg>
                    <span>Plugins</span>
                </a>
                <a asp-controller="ApplicationConfiguration" asp-action="Index" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition @NavLinkClasses("ApplicationConfiguration")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h3m-7.5 6h12m-10.5 6h9m4.5-6a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    <span>Configuration</span>
                </a>
                <a asp-controller="JobHistory" asp-action="Index" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition @NavLinkClasses("JobHistory")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5.25H7.5A2.25 2.25 0 0 0 5.25 7.5v9A2.25 2.25 0 0 0 7.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9A2.25 2.25 0 0 0 16.5 5.25H15m-6 0V3.75A1.5 1.5 0 0 1 10.5 2.25h3A1.5 1.5 0 0 1 15 3.75v1.5m-6 0h6m-6 4.5h6m-6 4.5h3" /></svg>
                    <span>Job History</span>
                </a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a href="/hangfire" class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium transition text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-slate-800/80 dark:hover:text-white">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                        <span>Hangfire</span>
                    </a>
                }
            </nav>

            <div class="mt-6 rounded-3xl border border-slate-200/70 bg-white/70 p-4 shadow-sm dark:border-white/10 dark:bg-slate-900/80">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Current session</p>
                        <p class="mt-1 text-sm font-medium text-slate-950 dark:text-white">@(User.Identity?.Name ?? "Anonymous")</p>
                    </div>
                    <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 dark:border-white/10 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white" @@click="darkMode = !darkMode">
                        <span class="sr-only">Toggle dark mode</span>
                        <svg x-show="!darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364 6.364-1.06-1.06M6.697 6.697 5.636 5.636m12.728 0-1.06 1.06M6.697 17.303l-1.06 1.06M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                        <svg x-show="darkMode" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75 9.75 9.75 0 0 1 8.25 6c0-1.33.266-2.597.748-3.752a9.753 9.753 0 1 0 12.754 12.754Z" /></svg>
                    </button>
                </div>

                <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 dark:border-white/10 dark:text-slate-200 dark:hover:border-sky-500/40 dark:hover:bg-sky-500/10 dark:hover:text-sky-200">
                            Change password
                        </a>
                        <a href="/hangfire" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 dark:border-white/10 dark:text-slate-200 dark:hover:border-sky-500/40 dark:hover:bg-sky-500/10 dark:hover:text-sky-200">
                            Open Hangfire dashboard
                        </a>
                    }
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="w-full rounded-2xl bg-slate-950 px-4 py-3 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">Log out</button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="flex min-h-screen flex-1 flex-col lg:pl-0">
            <header class="sticky top-0 z-30 border-b border-white/60 bg-white/70 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/60">
                <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
                    <div class="flex items-center gap-3">
                        <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 dark:border-white/10 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white lg:hidden" @@click="sidebarOpen = true">
                            <span class="sr-only">Open navigation</span>
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5m-16.5 6h16.5m-16.5 6h16.5" />
                            </svg>
                        </button>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">@pageSection</p>
                            <h1 class="text-lg font-semibold text-slate-950 dark:text-white">@ViewData["Title"]</h1>
                        </div>
                    </div>

                    <div class="hidden items-center gap-3 sm:flex">
                        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-300">
                            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                            @currentController/@currentAction
                        </span>
                    </div>
                </div>
            </header>

            <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
                @await Html.PartialAsync("_Toast")
                @RenderBody()
            </main>
        </div>
    </div>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
