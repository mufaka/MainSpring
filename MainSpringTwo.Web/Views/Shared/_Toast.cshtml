@{
    var toastMessage = TempData["Toast"]?.ToString() ?? ViewData["Toast"]?.ToString();
    var toastType = (TempData["ToastType"]?.ToString() ?? ViewData["ToastType"]?.ToString() ?? "success").ToLowerInvariant();
    var isError = toastType == "error";
    var title = isError ? "Action required" : "Update complete";
    var containerClasses = isError
        ? "border-rose-200 bg-white/95 dark:border-rose-500/20 dark:bg-slate-900/95"
        : "border-emerald-200 bg-white/95 dark:border-emerald-500/20 dark:bg-slate-900/95";
    var iconClasses = isError
        ? "bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300"
        : "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300";
}

@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <div x-data="{ show: true }"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-4"
         x-init="setTimeout(() => show = false, 4000)"
         @@click="show = false"
         class="fixed bottom-6 right-6 z-[100] w-[calc(100%-2rem)] max-w-sm cursor-pointer overflow-hidden rounded-3xl border p-4 shadow-2xl shadow-slate-950/15 backdrop-blur @containerClasses">
        <div class="flex items-start gap-3">
            <span class="mt-0.5 inline-flex h-10 w-10 items-center justify-center rounded-2xl @iconClasses">
                @if (isError)
                {
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008Zm9-3.758a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                }
                else
                {
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m6 2.25a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                }
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-slate-950 dark:text-white">@title</p>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">@toastMessage</p>
            </div>
            <button type="button" class="rounded-full p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-white" @@click.stop="show = false">
                <span class="sr-only">Dismiss</span>
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>
}
