@model PluginDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Plugin catalog</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">@Model.Name</h1>
            <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-300">@Model.Description</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200 dark:hover:bg-slate-800">Back to plugins</a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Registered</p>
            <p class="mt-3 text-2xl font-semibold text-slate-950 dark:text-white">@(Model.IsRegistered ? "Yes" : "No")</p>
        </div>
        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Status</p>
            <p class="mt-3 text-2xl font-semibold text-slate-950 dark:text-white">@(Model.IsActive ? "Active" : "Inactive")</p>
        </div>
        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Parameters</p>
            <p class="mt-3 text-2xl font-semibold text-slate-950 dark:text-white">@Model.Parameters.Count</p>
        </div>
    </div>

    <section class="overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/85 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
        <div class="border-b border-slate-200/70 px-6 py-5 dark:border-white/10">
            <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Configuration parameters</h2>
        </div>
        @if (Model.Parameters.Count == 0)
        {
            <div class="px-6 py-8 text-sm text-slate-600 dark:text-slate-300">This plugin has no configurable parameters.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
                    <thead class="bg-slate-50/80 dark:bg-slate-900/80">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Name</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Description</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Data type</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-white/10">
                        @foreach (var parameter in Model.Parameters)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm font-medium text-slate-950 dark:text-white">@parameter.Name</td>
                                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@parameter.Description</td>
                                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@parameter.DataType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
