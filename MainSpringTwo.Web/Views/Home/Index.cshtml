@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-8">
    <section class="grid gap-6 xl:grid-cols-[minmax(0,1.6fr),minmax(320px,1fr)]">
        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-600 dark:text-sky-300">Overview</p>
            <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Operational dashboard</h1>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
                Track automation health, inspect recent execution history, and trigger important jobs without leaving the main workspace.
            </p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-5 dark:border-white/10 dark:bg-slate-900/80">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Active jobs</p>
                    <p class="mt-3 text-3xl font-semibold text-slate-950 dark:text-white">@Model.ActiveScheduledJobs</p>
                </div>
                <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-5 dark:border-white/10 dark:bg-slate-900/80">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">Registered plugins</p>
                    <p class="mt-3 text-3xl font-semibold text-slate-950 dark:text-white">@Model.RegisteredPlugins</p>
                </div>
                <div class="rounded-3xl border border-emerald-200 bg-emerald-50/80 p-5 dark:border-emerald-500/20 dark:bg-emerald-500/10">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-700 dark:text-emerald-300">Recent successes</p>
                    <p class="mt-3 text-3xl font-semibold text-emerald-800 dark:text-emerald-200">@Model.RecentSuccessCount</p>
                </div>
                <div class="rounded-3xl border border-rose-200 bg-rose-50/80 p-5 dark:border-rose-500/20 dark:bg-rose-500/10">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-rose-700 dark:text-rose-300">Recent errors</p>
                    <p class="mt-3 text-3xl font-semibold text-rose-800 dark:text-rose-200">@Model.RecentErrorCount</p>
                </div>
            </div>
        </div>

        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Upcoming work</p>
            @if (Model.NextUpcomingJob is null || !Model.NextUpcomingRunTime.HasValue)
            {
                <div class="mt-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-sm text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300">
                    No active jobs are currently scheduled.
                </div>
            }
            else
            {
                <div class="mt-6 rounded-3xl border border-sky-200 bg-gradient-to-br from-sky-50 via-white to-cyan-50 p-6 dark:border-sky-500/20 dark:from-sky-500/10 dark:via-slate-950 dark:to-slate-950">
                    <p class="text-sm font-medium text-slate-600 dark:text-slate-300">Next scheduled run</p>
                    <h2 class="mt-3 text-2xl font-semibold text-slate-950 dark:text-white">@Model.NextUpcomingJob.Name</h2>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">@(Model.NextUpcomingJob.Plugin?.Name ?? "Unassigned plugin")</p>
                    <p class="mt-6 text-lg font-medium text-sky-700 dark:text-sky-300">@Model.NextUpcomingRunTime.Value.ToLocalTime().ToString("f")</p>
                </div>
            }
        </div>
    </section>

    <section class="grid gap-6 xl:grid-cols-[minmax(0,1.35fr),minmax(320px,1fr)]">
        <div class="overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/85 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <div class="flex items-center justify-between gap-4 border-b border-slate-200/70 px-6 py-5 dark:border-white/10">
                <div>
                    <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Recent job history</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Latest executions recorded in the last 24 hours.</p>
                </div>
                <a asp-controller="JobHistory" asp-action="Index" class="text-sm font-medium text-sky-700 hover:text-sky-600 dark:text-sky-300 dark:hover:text-sky-200">View all</a>
            </div>

            @if (Model.RecentEntries.Count == 0)
            {
                <div class="px-6 py-8 text-sm text-slate-600 dark:text-slate-300">No job executions were recorded in the last 24 hours.</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
                        <thead class="bg-slate-50/80 dark:bg-slate-900/80">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Run time</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Job</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Status</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Message</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-white/10">
                            @foreach (var entry in Model.RecentEntries)
                            {
                                <tr class="@(entry.IsError ? "bg-rose-50/70 dark:bg-rose-500/5" : string.Empty)">
                                    <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@entry.RunTime.ToLocalTime().ToString("g")</td>
                                    <td class="px-6 py-4 text-sm font-medium text-slate-950 dark:text-white">@(entry.ScheduledJob?.Name ?? "Scheduled job")</td>
                                    <td class="px-6 py-4 text-sm"><span class="inline-flex rounded-full px-3 py-1 text-xs font-medium @(entry.IsError ? "bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300")">@(entry.IsError ? "Error" : "Success")</span></td>
                                    <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@entry.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="rounded-[2rem] border border-slate-200/70 bg-white/85 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-950/70">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Quick actions</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Trigger active jobs directly from the dashboard.</p>
                </div>
                <a asp-controller="ScheduledJob" asp-action="Create" class="text-sm font-medium text-sky-700 hover:text-sky-600 dark:text-sky-300 dark:hover:text-sky-200">New job</a>
            </div>

            @if (Model.ActiveJobs.Count == 0)
            {
                <div class="mt-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-sm text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300">
                    Create an active scheduled job to enable quick actions.
                </div>
            }
            else
            {
                <div class="mt-6 space-y-3">
                    @foreach (var job in Model.ActiveJobs)
                    {
                        <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-4 dark:border-white/10 dark:bg-slate-900/60">
                            <div class="flex items-center justify-between gap-3">
                                <div>
                                    <p class="text-sm font-medium text-slate-950 dark:text-white">@job.Name</p>
                                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">@(job.Plugin?.Name ?? "Unassigned plugin")</p>
                                </div>
                                <form asp-controller="ScheduledJob" asp-action="RunNow" asp-route-id="@job.ScheduledJobId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">Run now</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>
