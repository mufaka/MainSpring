@page
@model MainSpringTwo.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<form method="post" class="space-y-6">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="space-y-2">
        <p class="text-sm text-slate-600 dark:text-slate-300">Create a local account for an operator or administrator.</p>
        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-200"></div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
            <label asp-for="Input.UserName" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="Input.UserName" class="block w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" autocomplete="username" />
            <span asp-validation-for="Input.UserName" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
        <div class="sm:col-span-2">
            <label asp-for="Input.Email" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="Input.Email" class="block w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
        <div>
            <label asp-for="Input.Password" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="Input.Password" class="block w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200"></label>
            <input asp-for="Input.ConfirmPassword" class="block w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-100 dark:border-white/10 dark:bg-slate-900/80 dark:text-white dark:focus:border-sky-500 dark:focus:ring-sky-500/20" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="mt-2 block text-sm text-rose-600 dark:text-rose-300"></span>
        </div>
    </div>

    <button type="submit" class="w-full rounded-2xl bg-slate-950 px-4 py-3 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">
        Create account
    </button>

    <p class="text-sm text-slate-600 dark:text-slate-300">
        Already have access?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-medium text-sky-700 hover:text-sky-600 dark:text-sky-300 dark:hover:text-sky-200">Sign in instead</a>
    </p>
</form>

