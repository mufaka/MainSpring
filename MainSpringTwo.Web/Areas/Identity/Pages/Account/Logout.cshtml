@page
@model MainSpringTwo.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="space-y-4 text-center">
    <p class="text-sm text-slate-600 dark:text-slate-300">Your session has been closed.</p>
    <a asp-page="./Login" class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-4 py-3 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">Return to sign in</a>
</div>
